<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.danmubox_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- 软键盘避让只有**一条**机制：界面自己补内边距。
             `MainActivity` 把「系统栏 ∪ 键盘」的高度下发成页面上的 safe-bottom 内边距令牌
             （`systemBars() or ime()`），`body` 用它让出底部空间，输入区因此落在键盘上沿 ——
             实测（模拟器 android-35，1080×2400@420dpi）：键盘弹出前后 `window.innerHeight`
             恒为 915 CSS px（窗口**没有**被 resize），该令牌 24 → 336.38 CSS px，
             输入区底边正好落在键盘上沿（gap = 0）。
             所以这里显式钉成 `adjustNothing`：不让系统再替我们 resize / pan 一次窗口。
             默认的 `adjustUnspecified` 在别的系统版本上可能解析成 `adjustResize`（视口再缩一次 →
             键盘高度被算两遍，内容比视口高 → 文档变成可滚容器 → 手指滑弹幕列表会接力滚它，
             整个界面被顶走）或 `adjustPan`（整窗平移，顶栏直接滑出屏幕）—— 两种都与「自补内边距」
             叠加成双重避让。详细口径与证据见 docs/ui.md §9.3。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
