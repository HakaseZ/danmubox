{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "danmubox",
  "version": "0.1.0",
  "identifier": "dev.kksk.danmubox",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "弹幕框",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
